{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "rules": {
    "import/no-cycle": "error",
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "complexity": ["error", { "max": 10 }],
    "max-depth": ["error", { "max": 3 }],
    "max-lines-per-function": [
      "error",
      { "max": 50, "skipBlankLines": true, "skipComments": true }
    ],
    "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    "max-params": ["error", { "max": 3 }],
    "no-nested-ternary": "error",
    "max-nested-callbacks": ["error", { "max": 3 }]
  },
  "overrides": [
    {
      "files": ["apps/server/**"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["**/*.spec.ts", "**/*.e2e-spec.ts"],
      "rules": {
        "max-lines-per-function": "off",
        "max-nested-callbacks": "off"
      }
    },
    {
      "files": [
        "apps/server/src/**/*.service.ts",
        "apps/server/src/**/*.controller.ts",
        "apps/server/src/**/*.gateway.ts",
        "apps/server/src/**/*.guard.ts",
        "apps/server/src/**/*.interceptor.ts",
        "apps/server/src/**/*.filter.ts",
        "apps/server/src/**/*.middleware.ts",
        "apps/server/src/**/*.processor.ts",
        "apps/server/src/**/*.repository.ts",
        "apps/server/src/**/*.listener.ts"
      ],
      "rules": {
        "max-params": ["error", { "max": 5 }]
      }
    }
  ]
}
