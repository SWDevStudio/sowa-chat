SOWA_ENV=development
NODE_ENV=development
SOWA_LOG_LEVEL=info
SOWA_LOG_FORMAT=pretty
# SOWA_SLOW_OPERATION_MS=500

SOWA_PUBLIC_PORT=8080
SOWA_OPERATOR_PORT=8081
SOWA_INTERNAL_PORT=8082
SOWA_MANAGEMENT_PORT=9090

DATABASE_URL=postgres://sowa:sowa@127.0.0.1:5432/sowa
# SOWA_DB_POOL_SIZE=10
# SOWA_MIGRATION_DATABASE_URL=postgres://sowa:sowa@127.0.0.1:5432/sowa
REDIS_URL=redis://127.0.0.1:6379

SOWA_S3_ENDPOINT=http://127.0.0.1:8333
SOWA_S3_ACCESS_KEY=sowa-dev
SOWA_S3_SECRET_KEY=sowa-dev-secret
SOWA_S3_BUCKET=sowa-chat

# SOWA_ENCRYPTION_KEYS=1:<32 bytes in base64>
# SOWA_TOKEN_SIGNING_KEYS=<kid>:<Ed25519 private key, PKCS8 DER in base64>
# SOWA_TOKEN_SIGNING_KEY_ID=<kid>
# SOWA_DEV_SECRETS_DIR=.sowa-dev
# SOWA_INIT_PROJECT=main
# SOWA_INIT_SERVER_KEY=<serverKey from sowa-chat key:generate>
# SOWA_INIT_ALLOWED_ORIGINS=https://shop.example.com
# SOWA_INIT_OPERATOR_ALLOWED_ORIGINS=https://admin.example.com
# SOWA_VISITOR_REFRESH_TTL_DAYS=30
